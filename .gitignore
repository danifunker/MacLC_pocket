# Verilator
verilator/obj_dir/
verilator/*.fst
verilator/*.vcd
verilator/cpu_trace.log
verilator/screenshot_frame_*.png

# ALL session scratch goes here (see CLAUDE.md)
scratch/

# OS junk
.DS_Store
Thumbs.db

# Boot ROM / disk images: copyrighted Apple content, never commit
releases/

# Quartus build products under src/fpga (project dir)
src/fpga/db/
src/fpga/incremental_db/
src/fpga/output_files/
src/fpga/.qsys_edit/

# Packaged SD-card payload: bitstream is a build product, ROM/disk images are
# copyrighted Apple content. The JSONs in dist/Cores are copies of the roots.
dist/Cores/
dist/Assets/
dist/assets/maclc/

# Local build crib: absolute paths and host-specific toolchain details that
# would be wrong on any other machine. Portable guidance lives in CLAUDE.md
# and docs/PORT_STATUS.md.
BUILDING.local.md

# MAME run artifacts (run_mame.sh / patch_scan.lua execute from the repo root)
cfg/
nvram/
snap/
output/
